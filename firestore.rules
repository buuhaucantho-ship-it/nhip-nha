rules_version = '2';
// Nhịp Nhà – quy tắc bảo mật Firestore (giai đoạn 1)
// Mỗi người chỉ đọc, ghi, xóa được tài liệu của chính mình: users/{uid}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000;
    }
    // Mọi đường dẫn khác đều bị chặn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
